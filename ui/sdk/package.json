{
  "name": "@personal-assistant/client",
  "version": "0.1.0",
  "description": "personal-assistant Web UI 协议客户端：REST + WebSocket（自动重连/回放去重），envelope 类型与 contracts.py 对齐",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "asst-cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.0"
  }
}
