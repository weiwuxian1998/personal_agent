# 复制为 .env 并填写；.env 已被 .gitignore 排除，任何真实密钥都不得提交。
# 变量名与 config.py 字段一一对应（大小写不敏感）。

# ============ 飞书自建应用 ============
FEISHU_APP_ID=cli_请替换为你的AppID
FEISHU_APP_SECRET=请替换为你的AppSecret
FEISHU_DOMAIN=https://open.feishu.cn

# ============ Redis（Stream / 去重 / 幂等） ============
REDIS_URL=redis://127.0.0.1:6379/0

# ============ Postgres（LangGraph checkpoint） ============
POSTGRES_DSN=postgresql://用户名:密码@127.0.0.1:5432/库名

# ============ DeepSeek（OpenAI 兼容） ============
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 思考模式 + 工具调用需要回传 reasoning_content（文档 §10.2）；v1 先关闭
LLM_THINKING_DISABLED=true
# 模型是否支持图片内容块（deepseek-flash 为文本模型，保持 false；
# 换视觉模型时改 true，Read 返回的 image_url 块会原样传给模型）
LLM_SUPPORTS_VISION=false

# ============ 运行目录（默认 ~/.assistant 与 ~/assistant-workspace） ============
# DATA_DIR=
# WORKSPACE_ROOT=

# ============ 运行参数（一般不用改） ============
# ROUTER_IDLE_EXIT_S=60
# ROUTER_READ_BLOCK_MS=5000
# BATCH_DEBOUNCE_MS=200
# BATCH_MAX=10
# ROUTER_SHELL_TIMEOUT_MS=30000
# WORKER_SHELL_TIMEOUT_MS=600000
# STALL_MINUTES=15
# LOG_LEVEL=INFO
